!-------------------------------------------------------------------------------khamlek:
! Gradient of molecular symmetry-constrained RMSE with respect to the reduced
! symmetry parameter vector.
!
! Chain rule:
!
!       dRMSE/ds = (dq/ds)^T * dRMSE/dq
!
! where
!       s = symmetry-reduced parameters
!       q = complete Cartesian MDCM
!
function sym_drmse_qtot(sqin,n) result(ds)
    implicit none

    integer, intent(in) :: n
    real(rp), intent(in) :: sqin(:)

    real(rp) :: ds(n)

    real(rp), dimension(num_charges*4) :: q
    real(rp), dimension(num_charges*4) :: qp
    real(rp), dimension(num_charges*4) :: qm
    real(rp), dimension(num_charges*4) :: gq

    real(rp), dimension(n) :: sp
    real(rp), dimension(n) :: sm

    real(rp) :: h
    integer :: j

    ! ----------------------------------------------------------
    ! Build the complete symmetric charge arrangement
    ! ----------------------------------------------------------
    call spawn_sym_chgs( &
         sqin, &
         q, &
         num_charges, &
         symFitAtms, &
         num_symFitAtms, &
         total_charge, &
         .true.)

    ! Analytical derivative in full Cartesian charge space
    gq = drmse_full(q,size(q))

    ds = 0._rp

    ! ----------------------------------------------------------
    ! Numerical Jacobian of ONLY the cheap symmetry transformation
    !
    !        dq/ds
    !
    ! We do NOT finite-difference the expensive ESP RMSE.
    ! ----------------------------------------------------------
    do j = 1,n

      sp = sqin
      sm = sqin

      h = 1.0e-6_rp * max(1.0_rp,abs(sqin(j)))

      sp(j) = sp(j) + h
      sm(j) = sm(j) - h

      call spawn_sym_chgs( &
           sp, &
           qp, &
           num_charges, &
           symFitAtms, &
           num_symFitAtms, &
           total_charge, &
           .true.)

      call spawn_sym_chgs( &
           sm, &
           qm, &
           num_charges, &
           symFitAtms, &
           num_symFitAtms, &
           total_charge, &
           .true.)

      ds(j) = dot_product( &
                   gq, &
                   (qp-qm)/(2.0_rp*h))

    enddo

end function sym_drmse_qtot
