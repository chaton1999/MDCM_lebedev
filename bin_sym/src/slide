!-------------------------------------------------------------------------------kahmlek:
! Full Cartesian derivative of RMSE.
!
! Unlike drmse(), ALL x,y,z,q values are treated as independent here.
! This derivative is needed before applying the symmetry chain rule.
!
function drmse_full(q,n) result(drmsedq)
    implicit none

    integer, intent(in) :: n
    real(rp), intent(in) :: q(:)

    real(rp) :: drmsedq(n)

    real(rp), dimension(size(q,dim=1)) :: q2
    real(rp), dimension(size(q,dim=1)) :: q3

    real(rp), dimension(size(q,dim=1)) :: tdrmsedq
    real(rp), dimension(size(q,dim=1)) :: ltdrmsedq
    real(rp), dimension(size(q,dim=1)) :: gtdrmsedq

    real(rp), dimension(4) :: dVdq
    real(rp), dimension(3) :: pt

    real(rp) :: fac
    real(rp) :: delta
    real(rp) :: rmse
    real(rp) :: r

    integer :: idx
    integer :: i
    integer :: k
    integer :: ix

    rmse = 0._rp
    drmsedq = 0._rp

    ! ==========================================================
    ! First conformer
    ! ==========================================================
    do idx = 1,Ngrid(1)

      pt = gridval(1,:,idx)

      delta = coulomb_potential(pt,q) - esp_grid(1,idx)

      rmse = rmse + delta**2

      do i = 1,num_charges

        dVdq = dcoulomb_potential(pt,q,i)

        ix = 4*(i-1)+1

        ! Existing dcoulomb_potential() assumes the final charge
        ! is constrained. For the full gradient we instead need:
        !
        !          dV/dq_i = 1/r_i
        !
        r = sqrt(sum((q(ix:ix+2)-pt)**2))

        if(r < 1.e-9_rp) r = 1.e-9_rp

        dVdq(4) = 1._rp/r

        drmsedq(ix  ) = drmsedq(ix  ) + delta*dVdq(1)
        drmsedq(ix+1) = drmsedq(ix+1) + delta*dVdq(2)
        drmsedq(ix+2) = drmsedq(ix+2) + delta*dVdq(3)
        drmsedq(ix+3) = drmsedq(ix+3) + delta*dVdq(4)

      enddo

    enddo


    ! ==========================================================
    ! Additional conformers
    ! ==========================================================
    do i = 2,Nconf

      tdrmsedq = 0._rp

      if(i == 2) then

        call assign_charges_to_atoms(q,1)

        call global_to_local( &
             q, &
             q2, &
             1)

      endif

      call local_to_global( &
           q2, &
           q3, &
           i)

      do idx = 1,Ngrid(i)

        pt = gridval(i,:,idx)

        delta = coulomb_potential(pt,q3) - esp_grid(i,idx)

        rmse = rmse + delta**2

        do k = 1,num_charges

          dVdq = dcoulomb_potential(pt,q3,k)

          ix = 4*(k-1)+1

          r = sqrt(sum((q3(ix:ix+2)-pt)**2))

          if(r < 1.e-9_rp) r = 1.e-9_rp

          dVdq(4) = 1._rp/r

          tdrmsedq(ix  ) = tdrmsedq(ix  ) + delta*dVdq(1)
          tdrmsedq(ix+1) = tdrmsedq(ix+1) + delta*dVdq(2)
          tdrmsedq(ix+2) = tdrmsedq(ix+2) + delta*dVdq(3)
          tdrmsedq(ix+3) = tdrmsedq(ix+3) + delta*dVdq(4)

        enddo

      enddo

      ! Transform derivative from current conformer's global
      ! frame -> local frame -> reference global frame
      call dglobal_to_local( &
           tdrmsedq, &
           ltdrmsedq, &
           i)

      call dlocal_to_global( &
           ltdrmsedq, &
           gtdrmsedq, &
           1)

      drmsedq = drmsedq + gtdrmsedq

    enddo


    ! ==========================================================
    ! Convert accumulated squared-error derivative to RMSE
    ! ==========================================================
    rmse = sqrt(rmse/NgridrTot)

    fac = 1._rp/(rmse*NgridrTot)

    do i = 1,num_charges

      ix = 4*(i-1)+1

      ! Keep the same position-gradient convention as existing drmse()
      drmsedq(ix  ) = -drmsedq(ix  )*fac
      drmsedq(ix+1) = -drmsedq(ix+1)*fac
      drmsedq(ix+2) = -drmsedq(ix+2)*fac

      ! Charge-magnitude derivative
      drmsedq(ix+3) = drmsedq(ix+3)*fac

    enddo

end function drmse_full
