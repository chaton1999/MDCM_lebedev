    if(allocated(popnew))       deallocate(popnew)
    if(allocated(fpop))         deallocate(fpop)
    if(allocated(fpopnew))      deallocate(fpopnew)
    if(allocated(fsblepop))     deallocate(fsblepop)
    if(allocated(fsblepopnew))  deallocate(fsblepopnew)
